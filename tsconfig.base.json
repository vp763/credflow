{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@credflow/shared/*": ["packages/shared/src/*"],
      "@credflow/config/*": ["packages/config/src/*"],
      "@credflow/db/*": ["packages/db/src/*"],
      "@credflow/api-client/*": ["packages/api-client/src/*"],
      "@credflow/ui/*": ["packages/ui/src/*"],
      "@credflow/identity/*": ["packages/identity/src/*"],
      "@credflow/tally/*": ["packages/tally/src/*"],
      "@credflow/receivables/*": ["packages/receivables/src/*"],
      "@credflow/collections/*": ["packages/collections/src/*"],
      "@credflow/payments/*": ["packages/payments/src/*"],
      "@credflow/analytics/*": ["packages/analytics/src/*"],
      "@credflow/notifications/*": ["packages/notifications/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".turbo"]
}